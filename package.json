{
  "name": "tauri-app",
  "private": true,
  "version": "0.8.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build-sidecars": "node scripts/stage-sidecars.mjs",
    "stage-conpty": "node scripts/stage-conpty.mjs",
