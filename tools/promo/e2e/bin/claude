#!/usr/bin/env python3
"""演示用的 Claude Code 替身:只打印预设剧本,不联网、不调用任何模型。

- mini-term 的输入检测把键入的 `claude` 识别为 AI 会话;
- 若 mini-term 开了 hook(PTY 环境里有 MINITERM_HOOK_PORT / MINITERM_PTY_ID),本脚本按
  Claude Code hook 的事件名 POST 到 mini-term 的 hook server(与 miniterm-hook sidecar
  同一份 payload 形状),于是「在跑 / 做完 / 等你批准」三种状态灯都能确定性地出现;
- 剧本按提示词里的关键字挑选(见 SCRIPTS),时长乘以 ~/.demo-speed(默认 1);
- ~/.demo-theme 写 light 时换浅色皮肤下读得清的 diff 配色。
"""
import json, os, random, re, shutil, sys, time, unicodedata, urllib.request

E = '\x1b['
R = E + '0m'
B = E + '1m'
def rgb(r, g, b): return f'{E}38;2;{r};{g};{b}m'
def bg(r, g, b): return f'{E}48;2;{r};{g};{b}m'
def _read(name, default):
    p = os.path.expanduser(f'~/.demo-{name}')
    return open(p).read().strip() if os.path.exists(p) else default
LIGHT = _read('theme', 'dark') == 'light'
SPEED = float(_read('speed', '1'))
CLAUDE = rgb(190, 90, 60) if LIGHT else rgb(215, 119, 87)
GRAY = E + '90m'
WHITE = E + '39m'
GREEN = E + '32m'
ADD = (bg(214, 240, 220) + rgb(20, 80, 40)) if LIGHT else (bg(24, 64, 40) + rgb(190, 240, 200))
DEL = (bg(250, 222, 225) + rgb(130, 20, 30)) if LIGHT else (bg(80, 28, 36) + rgb(255, 200, 205))
SESSION = f'demo-{os.getpid()}'


def out(s=''):
    sys.stdout.write(s + '\n'); sys.stdout.flush()


def hook(event, **extra):
    port, pty = os.environ.get('MINITERM_HOOK_PORT'), os.environ.get('MINITERM_PTY_ID')
    if not port or not pty:
        return
    body = {'pty_id': int(pty), 'event': event, 'agent': 'claude-code', 'session_id': SESSION, 'cwd': os.getcwd(), **extra}
    try:
        req = urllib.request.Request(f'http://127.0.0.1:{port}/hook', data=json.dumps(body).encode(),
                                     headers={'Content-Type': 'application/json'}, method='POST')
        urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=2).read()
    except Exception:
        pass


def cols():
    return max(40, min(shutil.get_terminal_size((100, 30)).columns, 110))


def visible_len(s):
    plain = re.sub(r'\x1b\[[0-9;]*m', '', s)
    return sum(2 if unicodedata.east_asian_width(c) in 'WF' else 1 for c in plain)


def banner():
    cwd = os.getcwd().replace(os.path.expanduser('~'), '~')
    out()
    out(f' {CLAUDE}▐▛███▜▌{R}   {B}{WHITE}Claude Code{R} {GRAY}v2.1.42{R}')
    out(f'{CLAUDE}▝▜█████▛▘{R}  {GRAY}Welcome back!{R}')
    out(f'  {CLAUDE}▘▘ ▝▝{R}    {GRAY}{cwd}{R}')
    out()


def rule():
    out(GRAY + '─' * cols() + R)


def prompt():
    rule()
    sys.stdout.write(f'{WHITE}> {R}'); sys.stdout.flush()
    try:
        line = sys.stdin.readline()
    except KeyboardInterrupt:
        return None
    if not line:
        return None
    rule()
    out(f'  {GRAY}? for shortcuts{R}')
    return line.strip()


SPIN = '✢✳✶✻✽✻✶✳'


def spinner(secs, verb):
    secs *= SPEED
    t0 = time.time(); i = 0; tokens = random.randint(200, 900)
    while time.time() - t0 < secs:
        el = int(time.time() - t0)
        tokens += random.randint(30, 90)
        sys.stdout.write(f'\r{CLAUDE}{SPIN[i % len(SPIN)]} {verb}…{R} {GRAY}({el}s · ↓ {tokens/1000:.1f}k tokens · esc to interrupt){R}{E}K')
        sys.stdout.flush(); i += 1; time.sleep(0.12)
    sys.stdout.write('\r' + E + 'K'); sys.stdout.flush()


def dot(text, color=WHITE):
    out(f'{color}●{R} {text}')


def tool(name, arg):
    hook('PreToolUse', tool_name=name)
    out(f'{GREEN}●{R} {B}{name}{R}({arg})')


def result(text):
    out(f'  {GRAY}⎿{R}  {text}')


def diff_line(num, sign, text):
    pad = ' ' * max(0, 62 - len(text))
    if sign == '+':
        out(f'      {GRAY}{num:>3}{R} {ADD}+ {text}{pad}{R}')
    elif sign == '-':
        out(f'      {GRAY}{num:>3}{R} {DEL}- {text}{pad}{R}')
    else:
        out(f'      {GRAY}{num:>3}{R}   {text}')


def run_orders():
    spinner(3.5, 'Thinking')
    dot('先看一下订单查询的实现和现有测试。')
    out()
    tool('Read', 'src/routes/orders.rs'); result('Read 18 lines')
    tool('Grep', 'pattern: "find_order"'); result('Found 3 files')
    out()
    spinner(5, 'Crafting')
    dot('问题在于逐条查询订单明细，改成一次 JOIN 拉取：')
    tool('Update', 'src/routes/orders.rs')
    result('Updated src/routes/orders.rs with 3 additions and 1 removal')
    diff_line(14, ' ', 'async fn get_order(Path(id): Path<u64>) -> Json<Order> {')
    diff_line(15, '-', '    Json(Order { id, status: "delivered", total_cents: 12_900 })')
    diff_line(15, '+', '    let order = repo::find_order_with_items(&pool, id).await?;')
    diff_line(16, '+', '    tracing::debug!(order.id, items = order.items.len());')
    diff_line(17, '+', '    Ok(Json(order))')
    diff_line(18, ' ', '}')
    out()
    tool('Bash', 'cargo test --quiet')
    spinner(5, 'Compiling')
    result('running 27 tests')
    result(f'test result: {GREEN}ok{R}. 27 passed; 0 failed; finished in 1.84s')
    out()
    dot(f'订单查询改为一次 JOIN，补了 {B}3{R} 个用例，{GREEN}27 个测试全部通过{R}。', CLAUDE)
    out()


def permission_box(cmd, desc):
    w = min(cols() - 2, 64)

    def line(s=''):
        out(f'{CLAUDE}│{R} {s}{" " * max(0, w - 3 - visible_len(s))}{CLAUDE}│{R}')

    out(f'{CLAUDE}╭' + '─' * (w - 2) + f'╮{R}')
    line(f'{B}Bash command{R}')
    line()
    line(f'  {cmd}')
    line(f'  {GRAY}{desc}{R}')
    line()
    line('Do you want to proceed?')
    line(f'{CLAUDE}❯{R} 1. Yes')
    line("  2. Yes, and don't ask again for kubectl")
    line('  3. No, and tell Claude what to do differently')
    out(f'{CLAUDE}╰' + '─' * (w - 2) + f'╯{R}')


def run_deploy():
    spinner(3, 'Thinking')
    dot('先确认 staging 当前的部署状态。')
    tool('Bash', 'kubectl get deploy orbit-api -n staging')
    result('orbit-api   3/3   3   3   12d')
    out()
    spinner(2.5, 'Planning')
    dot('镜像已推送，准备滚动更新 staging：')
    out()
    permission_box('kubectl apply -f k8s/ -n staging', 'Apply manifests to the staging cluster')
    hook('PermissionRequest', tool_name='Bash', message='Claude needs your permission to use Bash')
    ans = sys.stdin.readline().strip()
    if ans in ('', '1', '2', 'y', 'yes'):
        hook('PreToolUse', tool_name='Bash')
        spinner(4, 'Deploying')
        result('deployment.apps/orbit-api configured')
        result(f'{GREEN}rollout complete{R} · 3/3 pods ready')
        out()
        dot('staging 已更新到最新镜像。', CLAUDE)
    else:
        dot('已取消，未做任何改动。', CLAUDE)
    out()


def run_generic():
    spinner(5, 'Pondering')
    dot('分析完成，改动如下：')
    tool('Update', 'README.md'); result('Updated README.md with 6 additions')
    spinner(3, 'Crafting')
    dot('已更新文档。', CLAUDE)
    out()


SCRIPTS = [('部署', run_deploy), ('deploy', run_deploy), ('订单', run_orders), ('N+1', run_orders), ('order', run_orders)]


def main():
    banner()
    hook('SessionStart', source='startup')
    while True:
        msg = prompt()
        if msg is None or msg in ('/exit', 'exit'):
            hook('SessionEnd', reason='exit')
            break
        if not msg:
            continue
        hook('UserPromptSubmit', prompt=msg)
        run = next((fn for key, fn in SCRIPTS if key in msg), run_generic)
        run()
        hook('Stop')


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        hook('SessionEnd', reason='interrupt')
